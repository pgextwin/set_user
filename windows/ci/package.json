{
  "schemaVersion": 1,
  "distribution": "dll-sql",
  "files": [
    {
      "source": "upstream",
      "path": "set_user.dll",
      "destination": "lib/set_user.dll",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "set_user.control",
      "destination": "share/extension/set_user.control",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "src/set_user.h",
      "destination": "include/set_user.h",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "CHANGELOG.md",
      "destination": "UPSTREAM-CHANGELOG.md",
      "targets": [
        "zip"
      ],
      "optional": true
    },
    {
      "source": "upstream",
      "path": "extension/set_user--*.sql",
      "destination": "share/extension/{fileName}",
      "targets": [
        "install",
        "zip"
      ],
      "expectedCount": 1
    },
    {
      "source": "upstream",
      "path": "updates/*.sql",
      "destination": "share/extension/{fileName}",
      "targets": [
        "install",
        "zip"
      ],
      "expectedCount": 14
    }
  ],
  "packageInfo": [
    "set_user Windows binary package",
    "===============================",
    "",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref:        {upstreamRef}",
    "Upstream commit:     {upstreamCommit}",
    "set_user version:    {version}",
    "PostgreSQL major:    {pgMajor}",
    "PostgreSQL tested:   {pgTested}",
    "Architecture:        Windows x64",
    "Compiler:            MSVC",
    "License:             PostgreSQL License; see LICENSE",
    "",
    "This is an unofficial pgextwin Windows package built from the official set_user source.",
    "The package also includes include/set_user.h because upstream install exposes this header",
    "for extensions that register set_user post-execution hooks."
  ],
  "sqlVersion": "4.3.0"
}
